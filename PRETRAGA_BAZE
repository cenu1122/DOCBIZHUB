
<!DOCTYPE html>
<html lang="bs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DocBizHub - Pametna poslovna pretraga</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
* {margin:0;padding:0;box-sizing:border-box}

body {
  font-family:Segoe UI,Tahoma,sans-serif;
  background:#f4f6f9;
  color:#2b2d42;
  min-height:100vh;
  display:flex;
  flex-direction:column;
}

header {
  background:#2b2d42;
  color:white;
  padding:18px 5%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:12px;
}

.logo {
  color:white;
  font-size:1.4rem;
  font-weight:bold;
  text-decoration:none;
}

.btn-back {
  background:#d90429;
  color:white;
  padding:9px 16px;
  border-radius:20px;
  text-decoration:none;
}

.main-container {
  max-width:1000px;
  width:100%;
  margin:30px auto;
  padding:0 15px;
  flex:1;
}

.card {
  background:white;
  border-radius:12px;
  padding:25px;
  margin-bottom:22px;
  box-shadow:0 4px 12px rgba(0,0,0,.07);
}

h2 {color:#d90429;margin-bottom:10px}

.sub {
  color:#666;
  margin-bottom:22px;
  line-height:1.5;
}

.form-group {
  margin-bottom:17px;
  display:flex;
  flex-direction:column;
  gap:7px;
}

label {font-weight:bold;font-size:.92rem}

input,textarea {
  padding:13px;
  border:1px solid #ccc;
  border-radius:8px;
  font-size:15px;
  width:100%;
}

textarea {
  min-height:85px;
  resize:vertical;
}

input:focus,textarea:focus {
  outline:none;
  border-color:#4f46e5;
}

.btn {
  width:100%;
  padding:15px;
  border:0;
  border-radius:8px;
  color:white;
  font-weight:bold;
  font-size:16px;
  cursor:pointer;
  background:#4f46e5;
}

.btn:hover {background:#4338ca}
.btn:disabled {opacity:.6;cursor:wait}

#infoBox {
  display:none;
  padding:14px;
  margin-top:18px;
  border-radius:8px;
  background:#e8f4fd;
  color:#075985;
  line-height:1.6;
}

#results {
  display:none;
}

.result-card {
  background:#f8fafc;
  border:1px solid #dbe2ea;
  padding:18px;
  border-radius:10px;
  margin-bottom:14px;
  line-height:1.65;
  overflow-wrap:anywhere;
}

.result-card h3 {
  color:#d90429;
  margin-bottom:10px;
}

.result-card p {margin-top:6px}

.score {
  display:inline-block;
  background:#dcfce7;
  color:#166534;
  padding:4px 10px;
  border-radius:15px;
  font-weight:bold;
  font-size:13px;
  margin-bottom:10px;
}

.type {
  display:inline-block;
  background:#e0e7ff;
  color:#3730a3;
  padding:4px 10px;
  border-radius:15px;
  font-size:12px;
  margin-bottom:10px;
}

.section-title {
  margin:25px 0 15px;
  color:#2b2d42;
  border-bottom:2px solid #e5e7eb;
  padding-bottom:9px;
}

.result-link {
  display:inline-block;
  margin-top:10px;
  color:#2563eb;
  font-weight:bold;
}

.empty {
  background:#fff7ed;
  padding:15px;
  border-radius:8px;
  color:#9a3412;
}

footer {
  background:#2b2d42;
  color:white;
  text-align:center;
  padding:20px;
}
</style>
</head>

<body>

<header>
  <a href="DASHBOARD.html" class="logo">
    ❤️ DocBizHub
  </a>

  <a href="DASHBOARD.html" class="btn-back">
    ⬅ Nazad
  </a>
</header>

<main class="main-container">

<div class="card">

<h2>🤖 Pametna poslovna pretraga</h2>

<p class="sub">
Unesite šta nudite i šta tražite.
Sistem će direktno pretražiti poslovnu bazu,
pronaći potencijalne kupce, dobavljače i oglase.
</p>

<div class="form-group">
<label>🔍 Osnovni pojam pretrage</label>
<input id="searchInput"
placeholder="Npr. EUR palete, transport, građevinski materijal">
</div>

<div class="form-group">
<label>📦 Šta nudite?</label>
<textarea id="ponuda"
placeholder="Npr. Nudim 5000 EUR paleta mjesečno, isporuka Njemačka..."></textarea>
</div>

<div class="form-group">
<label>🎯 Šta tražite?</label>
<textarea id="potraznja"
placeholder="Npr. Tražim kupce, distributere i veletrgovce..."></textarea>
</div>

<div class="form-group">
<label>📍 Dodatni detalji</label>
<textarea id="detalji"
placeholder="Npr. Njemačka, Bavarska, veleprodaja..."></textarea>
</div>

<button class="btn" id="searchButton"
onclick="pokreniPretragu()">
🚀 PRETRAŽI POSLOVNU BAZU
</button>

<div id="infoBox"></div>

</div>

<div class="card" id="results">

<h2>📊 Rezultati poslovne pretrage</h2>

<div id="summary"></div>

<h3 class="section-title">
🏢 Pronađene firme
</h3>

<div id="companyResults"></div>

<h3 class="section-title">
📢 Pronađeni oglasi
</h3>

<div id="adResults"></div>

<h3 class="section-title">
💰 Potencijalni kupci
</h3>

<div id="buyerResults"></div>

</div>

</main>

<footer>
© 2026 DocBizHub. Sva prava zadržana.
</footer>

<script>

// =====================================================
// SUPABASE
// =====================================================

const SUPABASE_URL =
'https://uduwpvdjmanrgpumdrfh.supabase.co';

const SUPABASE_ANON_KEY =
'sb_publishable_IfX6dxz-ILfYK_3VgelcMw_tYOX0y45';

const _supabase = supabase.createClient(
  SUPABASE_URL,
  SUPABASE_ANON_KEY
);

// =====================================================
// HELPERS
// =====================================================

function text(value) {
  return String(value ?? '').trim();
}

function safeLink(value,label) {
  if(!value) return '';

  try {
    const url = new URL(value);

    if(!['http:','https:'].includes(url.protocol))
      return '';

    const a = document.createElement('a');
    a.href = url.href;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.className = 'result-link';
    a.textContent = label;

    return a;

  } catch {
    return '';
  }
}

function addField(card,label,value) {
  if(!text(value)) return;

  const p = document.createElement('p');

  const strong = document.createElement('strong');
  strong.textContent = label + ': ';

  const span = document.createElement('span');
  span.textContent = value;

  p.append(strong,span);
  card.appendChild(p);
}

// =====================================================
// GENERIC RESULT CARD
// =====================================================

function napraviKarticu(item,index,vrsta) {

  const card = document.createElement('div');
  card.className = 'result-card';

  const naslov = document.createElement('h3');

  naslov.textContent =
    `${index+1}. ${
      text(item.naziv) ||
      text(item.naslov) ||
      'Nepoznat rezultat'
    }`;

  card.appendChild(naslov);

  if(item.score !== undefined) {
    const score = document.createElement('div');
    score.className = 'score';
    score.textContent = 'Podudaranje: ' + item.score + '%';
    card.appendChild(score);
  }

  if(item.tip) {
    const tip = document.createElement('div');
    tip.className = 'type';

    tip.textContent =
      item.tip === 'POTENCIJALNI_KUPAC'
      ? 'POTENCIJALNI KUPAC'
      : item.tip === 'DOBAVLJAC'
      ? 'DOBAVLJAČ'
      : item.tip;

    card.appendChild(tip);
  }

  addField(card,'Djelatnost',item.djelatnost);
  addField(card,'Opis',item.opis);
  addField(card,'Šta nudi',item.ja);
  addField(card,'Šta traži',item.trazim);
  addField(card,'Oglas',item.tip_oglasa);
  addField(card,'Vrsta posla',item.vrsta_posla);
  addField(card,'Lokacija',[
    item.grad,
    item.drzava
  ].filter(Boolean).join(', '));

  addField(card,'Poštanski broj',item.postanski_broj);
  addField(card,'Telefon',item.telefon);
  addField(card,'Email',item.email);
  addField(card,'Email prodaja',item.mail_prodaja);
  addField(card,'Email nabavka',item.mail_nabavka);

  addField(card,'Razlog podudaranja',item.razlog);

  if(item.podudarne_rijeci?.length) {
    addField(
      card,
      'Podudarne riječi',
      item.podudarne_rijeci.join(', ')
    );
  }

  addField(card,'Izvor podataka',item.izvor_podatka);
  addField(card,'Status oglasa',item.status_oglasa);

  const web = safeLink(item.web,'🌐 Posjeti web stranicu');

  if(web) card.appendChild(web);

  const oglas = safeLink(item.url,'📢 Otvori oglas');

  if(oglas) card.appendChild(oglas);

  const izvor = safeLink(item.izvor,'🔗 Pogledaj izvor');

  if(izvor) card.appendChild(izvor);

  return card;
}

// =====================================================
// DISPLAY RESULTS
// =====================================================

function prikaziListu(containerId,items,vrsta) {

  const container = document.getElementById(containerId);
  container.replaceChildren();

  if(!Array.isArray(items) || !items.length) {

    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.textContent = 'Nema pronađenih rezultata.';

    container.appendChild(empty);
    return;
  }

  items.forEach((item,index) => {
    container.appendChild(
      napraviKarticu(item,index,vrsta)
    );
  });
}

// =====================================================
// MAIN SEARCH
// =====================================================

async function pokreniPretragu() {

  const pojam =
    text(document.getElementById('searchInput').value);

  const ponuda =
    text(document.getElementById('ponuda').value);

  const potraznja =
    text(document.getElementById('potraznja').value);

  const detalji =
    text(document.getElementById('detalji').value);

  const button =
    document.getElementById('searchButton');

  const info =
    document.getElementById('infoBox');

  const results =
    document.getElementById('results');

  if(!pojam) {
    alert('Unesite pojam pretrage.');
    return;
  }

  button.disabled = true;
  button.textContent = '⏳ Pretražujem poslovnu bazu...';

  info.style.display = 'block';
  info.style.color = '#075985';
  info.textContent =
    'Učitavam firme i oglase iz Supabase baze...';

  results.style.display = 'none';

  try {

    // Poziv funkcije
    const {data,error} =
      await _supabase.functions.invoke(
        'PRETRAGA_BAZE_BEZ_GROQA',
        {
          body: {
            pojam: pojam,
            detalji: detalji,

            poslovna_analiza: {
              sta_korisnik_nudi: ponuda,
              sta_korisnik_trazi: potraznja,
              ponuda: ponuda,
              potraznja: potraznja
            }
          }
        }
      );

    if(error) throw error;

    if(!data || !data.success) {
      throw new Error(
        data?.error || 'Pretraga nije uspjela.'
      );
    }

    // Prikaz statistike
    const summary =
      document.getElementById('summary');

    summary.replaceChildren();

    const statistika = [
      ['Pregledano firmi',data.pregledano_firmi],
      ['Pregledano oglasa',data.pregledano_oglasa],
      ['Pronađeno firmi',data.broj_firmi],
      ['Pronađeno oglasa',data.broj_oglasa],
      ['Potencijalnih kupaca',data.broj_potencijalnih_kupaca]
    ];

    statistika.forEach(([label,value]) => {

      const p = document.createElement('p');
      p.style.margin = '8px 0';

      const strong = document.createElement('strong');
      strong.textContent = label + ': ';

      const span = document.createElement('span');
      span.textContent = value ?? 0;

      p.append(strong,span);
      summary.appendChild(p);
    });

    // Tri kategorije rezultata
    prikaziListu(
      'companyResults',
      data.podudaranja_u_bazi,
      'firma'
    );

    prikaziListu(
      'adResults',
      data.oglasi_u_bazi,
      'oglas'
    );

    prikaziListu(
      'buyerResults',
      data.potencijalni_kupci,
      'kupac'
    );

    results.style.display = 'block';

    info.style.color = '#166534';

    info.textContent =
      'Pretraga uspješno završena. ' +
      'Rezultati su učitani direktno iz Supabase baze. ' +
      'Groq i Tavily nisu korišteni.';

  } catch(error) {

    info.style.color = '#dc2626';

    info.textContent =
      'Greška pri pretrazi: ' + error.message;

  } finally {

    button.disabled = false;

    button.textContent =
      '🚀 PRETRAŽI POSLOVNU BAZU';
  }
}

// ENTER
document.getElementById('searchInput')
.addEventListener('keypress',function(event) {
  if(event.key === 'Enter') {
    pokreniPretragu();
  }
});

</script>

</body>
</html>
