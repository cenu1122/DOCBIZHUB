```html
<!DOCTYPE html>
<html lang="bs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pokreni biznis | DocBizHub</title>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
    }

    body {
        background: #f4f7fb;
        color: #172033;
        min-height: 100vh;
    }

    .header {
        background: linear-gradient(135deg, #0f172a, #1d4ed8);
        color: white;
        padding: 30px 20px;
    }

    .header-inner {
        max-width: 1100px;
        margin: auto;
    }

    .header h1 {
        font-size: 32px;
        margin-bottom: 8px;
    }

    .header p {
        opacity: .9;
    }

    .container {
        max-width: 1100px;
        margin: 30px auto;
        padding: 0 20px;
    }

    .card {
        background: white;
        border-radius: 18px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,.07);
    }

    .card h2 {
        margin-bottom: 20px;
        font-size: 22px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .field.full {
        grid-column: 1 / -1;
    }

    label {
        font-weight: bold;
        font-size: 14px;
    }

    input,
    select,
    textarea {
        width: 100%;
        padding: 13px;
        border: 1px solid #d5dbe5;
        border-radius: 10px;
        font-size: 15px;
        outline: none;
    }

    input:focus,
    select:focus,
    textarea:focus {
        border-color: #2563eb;
    }

    textarea {
        min-height: 100px;
        resize: vertical;
    }

    .button {
        border: none;
        background: #2563eb;
        color: white;
        padding: 14px 24px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 16px;
        font-weight: bold;
        margin-top: 20px;
    }

    .button:hover {
        background: #1d4ed8;
    }

    .secondary {
        background: #e8eefc;
        color: #1d4ed8;
        margin-left: 10px;
    }

    .secondary:hover {
        background: #dbe5fb;
    }

    #rezultat {
        display: none;
    }

    .result-title {
        color: #1d4ed8;
        margin-bottom: 15px;
    }

    .result-box {
        background: #f8fafc;
        border-left: 4px solid #2563eb;
        padding: 16px;
        border-radius: 8px;
        margin: 12px 0;
    }

    .result-box h3 {
        margin-bottom: 8px;
    }

    ul {
        padding-left: 20px;
        line-height: 1.8;
    }

    .budget {
        font-size: 25px;
        font-weight: bold;
        color: #16a34a;
    }

    .steps {
        counter-reset: steps;
    }

    .step {
        margin: 12px 0;
        padding: 15px;
        background: #f8fafc;
        border-radius: 10px;
    }

    .footer {
        text-align: center;
        padding: 30px;
        color: #64748b;
        font-size: 14px;
    }

    @media(max-width: 700px) {
        .grid {
            grid-template-columns: 1fr;
        }

        .field.full {
            grid-column: auto;
        }

        .secondary {
            margin-left: 0;
        }
    }
</style>
</head>

<body>

<header class="header">
    <div class="header-inner">
        <h1>🚀 Pokreni biznis</h1>
        <p>Od ideje do prvog konkretnog plana poslovanja.</p>
    </div>
</header>

<main class="container">

    <section class="card">
        <h2>💡 Tvoja poslovna ideja</h2>

        <div class="grid">

            <div class="field full">
                <label for="ideja">Šta želiš pokrenuti?</label>
                <textarea id="ideja"
                    placeholder="Npr. servis računara, online prodaja odjeće, autopraonica..."></textarea>
            </div>

            <div class="field">
                <label for="lokacija">Grad / država</label>
                <input id="lokacija" placeholder="Npr. Travnik, BiH">
            </div>

            <div class="field">
                <label for="budzet">Početni budžet (€)</label>
                <input id="budzet" type="number" placeholder="Npr. 5000">
            </div>

            <div class="field">
                <label for="tip">Vrsta biznisa</label>
                <select id="tip">
                    <option value="usluge">Usluge</option>
                    <option value="prodaja">Prodaja proizvoda</option>
                    <option value="online">Online biznis</option>
                    <option value="ugostiteljstvo">Ugostiteljstvo</option>
                    <option value="proizvodnja">Proizvodnja</option>
                    <option value="drugo">Drugo</option>
                </select>
            </div>

            <div class="field">
                <label for="iskustvo">Imaš li iskustva?</label>
                <select id="iskustvo">
                    <option value="da">Da</option>
                    <option value="ne">Ne</option>
                    <option value="malo">Imam malo iskustva</option>
                </select>
            </div>

        </div>

        <button class="button" onclick="pokreniBiznis()">
            🚀 Napravi moj plan
        </button>

        <button class="button secondary" onclick="ocistiFormu()">
            🔄 Očisti
        </button>
    </section>


    <section class="card" id="rezultat">

        <h2 class="result-title">📋 Tvoj početni poslovni plan</h2>

        <div class="result-box">
            <h3>💡 Ideja</h3>
            <p id="rIdeja"></p>
        </div>

        <div class="result-box">
            <h3>📍 Lokacija</h3>
            <p id="rLokacija"></p>
        </div>

        <div class="result-box">
            <h3>💰 Početni budžet</h3>
            <p class="budget" id="rBudzet"></p>
        </div>

        <div class="result-box">
            <h3>🏢 Model poslovanja</h3>
            <p id="rTip"></p>
        </div>

        <div class="result-box">
            <h3>💸 Predložena raspodjela budžeta</h3>
            <ul id="troskovi"></ul>
        </div>

        <div class="result-box">
            <h3>📅 Prvih 30 dana</h3>

            <div class="steps">

                <div class="step">
                    <strong>1. sedmica — Istraživanje</strong>
                    <p>
                        Definiši kupca, provjeri konkurenciju i potvrdi da postoji
                        potražnja za tvojom ponudom.
                    </p>
                </div>

                <div class="step">
                    <strong>2. sedmica — Ponuda</strong>
                    <p>
                        Napravi konkretnu ponudu, odredi cijene i pripremi osnovne
                        materijale za prodaju.
                    </p>
                </div>

                <div class="step">
                    <strong>3. sedmica — Prvi klijenti</strong>
                    <p>
                        Kontaktiraj potencijalne kupce, koristi networking i
                        testiraj ponudu na tržištu.
                    </p>
                </div>

                <div class="step">
                    <strong>4. sedmica — Poboljšanje</strong>
                    <p>
                        Analiziraj rezultate, razgovaraj s klijentima i popravi
                        ono što ne funkcioniše.
                    </p>
                </div>

            </div>
        </div>

        <div class="result-box">
            <h3>✅ Sljedeći koraci</h3>
            <ul>
                <li>Definisati ciljnu grupu.</li>
                <li>Provjeriti konkurenciju.</li>
                <li>Napraviti osnovnu ponudu.</li>
                <li>Izračunati stvarne troškove.</li>
                <li>Provjeriti potrebnu registraciju i dozvole.</li>
                <li>Pronaći prve potencijalne klijente.</li>
                <li>Pokrenuti testnu prodaju.</li>
            </ul>
        </div>

    </section>

</main>

<footer class="footer">
    DocBizHub • Pokreni biznis
</footer>


<script>

function pokreniBiznis() {

    const ideja = document.getElementById("ideja").value.trim();
    const lokacija = document.getElementById("lokacija").value.trim();
    const budzet = Number(document.getElementById("budzet").value);
    const tip = document.getElementById("tip").value;

    if (!ideja) {
        alert("Unesi svoju poslovnu ideju.");
        return;
    }

    if (!lokacija) {
        alert("Unesi grad ili državu.");
        return;
    }

    if (!budzet || budzet <= 0) {
        alert("Unesi početni budžet.");
        return;
    }

    const nazivi = {
        usluge: "Biznis zasnovan na uslugama",
        prodaja: "Prodaja proizvoda",
        online: "Online biznis",
        ugostiteljstvo: "Ugostiteljski biznis",
        proizvodnja: "Proizvodni biznis",
        drugo: "Drugi tip biznisa"
    };

    document.getElementById("rIdeja").textContent = ideja;
    document.getElementById("rLokacija").textContent = lokacija;
    document.getElementById("rBudzet").textContent =
        budzet.toLocaleString("de-DE") + " €";

    document.getElementById("rTip").textContent = nazivi[tip];

    const oprema = Math.round(budzet * 0.30);
    const marketing = Math.round(budzet * 0.15);
    const registracija = Math.round(budzet * 0.10);
    const rezerva = Math.round(budzet * 0.25);
    const ostalo = Math.round(budzet * 0.20);

    document.getElementById("troskovi").innerHTML = `
        <li>Oprema / početna ulaganja: <strong>${oprema.toLocaleString("de-DE")} €</strong></li>
        <li>Marketing: <strong>${marketing.toLocaleString("de-DE")} €</strong></li>
        <li>Registracija / administracija: <strong>${registracija.toLocaleString("de-DE")} €</strong></li>
        <li>Rezervni fond: <strong>${rezerva.toLocaleString("de-DE")} €</strong></li>
        <li>Ostali troškovi: <strong>${ostalo.toLocaleString("de-DE")} €</strong></li>
    `;

    document.getElementById("rezultat").style.display = "block";

    document.getElementById("rezultat")
        .scrollIntoView({ behavior: "smooth" });
}


function ocistiFormu() {

    document.getElementById("ideja").value = "";
    document.getElementById("lokacija").value = "";
    document.getElementById("budzet").value = "";

    document.getElementById("rezultat").style.display = "none";
}

</script>

</body>
</html>
